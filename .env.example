# Copie este arquivo para .env.local e preencha com os dados do seu projeto Supabase.
# URL: botão "Connect" no topo do painel, ou Project Settings > Data API
# Chave: Project Settings > API Keys > Publishable key (ou a "anon" key em Legacy API Keys)
# NUNCA use a Secret key / service_role aqui.
VITE_SUPABASE_URL=https://SEU-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_sua-chave
